{
  "name": "tagflow-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "TagFlow Playwright end-to-end tests. Drives an isolated Rust backend via env vars.",
  "scripts": {
    "test": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test",
    "test:headed": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
