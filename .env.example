# TagFlow Docker 部署环境变量样例
# 复制为 .env 并填写实际值后执行 docker compose up -d

# === 必填：JWT 签名密钥（≥ 32 字节；建议 openssl rand -hex 32 生成）===
TAGFLOW_JWT_SECRET=please_generate_a_secret_at_least_32_bytes_long

# === 必填：首次启动创建管理员用密码（≥ 12 字节；已有用户时忽略）===
TAGFLOW_ADMIN_PASSWORD=please_change_this_password

# === 可选：管理员用户名（首次启动用，默认 admin）===
TAGFLOW_ADMIN_USERNAME=admin

# === 可选：定时增量扫描间隔（秒，默认 3600；低于 60 会被 clamp 回 60，非法值回退 3600）===
TAGFLOW_SCAN_INTERVAL=3600
